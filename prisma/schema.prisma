generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  website   String
  budget    String
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brands")
}

model Creator {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  socialMedia String   @map("social_media")
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("creators")
}

model PageEvent {
  id        Int      @id @default(autoincrement())
  event     String
  page      String
  meta      String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_events")
}
