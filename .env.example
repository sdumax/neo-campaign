NODE_ENV=production
DATABASE_URL="postgresql://CPANEL_DB_USER:URL_ENCODED_CPANEL_DB_PASSWORD@localhost:5432/CPANEL_DB_NAME?schema=public"
DASHBOARD_USER="your_admin_user"
DASHBOARD_PASSWORD="your_secure_password"
# Optional: YouTube Data API v3 key for automatic channel stats/videos sync
YOUTUBE_API_KEY="AIzaSy..."
# Optional: YouTube auto-refresh sync interval in days (default: 3 for at least twice a week)
YOUTUBE_SYNC_INTERVAL_DAYS="3"
